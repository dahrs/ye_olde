# Copy to .env and fill in. See docs/diachronic-translation-pipeline-plan.md §8
# for the reasoning behind the choices left blank here.

# Embedding backend (self-hosted via sentence-transformers)
# multilingual-e5-large is the best-quality e5 variant a Pi 5 (16GB,
# CPU-only) can run. Change this if you're on different/lighter hardware,
# e.g. intfloat/multilingual-e5-small — but don't leave it as `KEY=` with no
# value: an empty string here overrides the code default in config.py with
# "", it doesn't fall back to it. Delete the line instead if you want the
# code default.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Generation LLM (via litellm — supports API providers and local/OpenAI-compatible endpoints)
LITELLM_MODEL=                # e.g. anthropic/claude-... or openai/<name> for a local llama.cpp/vLLM server
LITELLM_API_KEY=              # only needed for API providers (local servers: any placeholder string works)
LITELLM_API_BASE=             # only needed for local/self-hosted endpoints, e.g. http://localhost:8080/v1

# Optional: raw JSON merged into every litellm.completion() call as extra_body.
# Needed for backends that default to a "thinking"/reasoning preamble which
# otherwise burns the whole token budget before producing the JSON this
# pipeline's ingest/llm_client.py requires. Provider-specific, so this is
# left blank rather than guessed at — see README's "Local LLM (llama.cpp)"
# section for the exact value that works for a locally-served Qwen3(.5)
# model, e.g. LITELLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LITELLM_EXTRA_BODY=

# Search API (spec §10) — the pipeline calls this instead of holding a
# corpus/index locally. Local dev default assumes `search_api/` running via
# `uvicorn app.main:app --port 8000` from that directory; production is the
# HF Space's URL, e.g. https://<user>-ye-olde-api.hf.space
SEARCH_API_URL=http://localhost:8000
