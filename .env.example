# Copy to .env and fill in. See docs/diachronic-translation-pipeline-plan.md §8
# for the reasoning behind the choices left blank here.

# Embedding backend (self-hosted via sentence-transformers)
# multilingual-e5-large is the best-quality e5 variant a Pi 5 (16GB,
# CPU-only) can run. Change this if you're on different/lighter hardware,
# e.g. intfloat/multilingual-e5-small — but don't leave it as `KEY=` with no
# value: an empty string here overrides the code default in config.py with
# "", it doesn't fall back to it. Delete the line instead if you want the
# code default.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Generation LLM (via litellm — supports API providers and local/OpenAI-compatible endpoints)
LITELLM_MODEL=                # e.g. anthropic/claude-... or openai/<name> for a local llama.cpp/vLLM server
LITELLM_API_KEY=              # only needed for API providers (local servers: any placeholder string works)
LITELLM_API_BASE=             # only needed for local/self-hosted endpoints, e.g. http://localhost:8080/v1

# Optional: raw JSON merged into every litellm.completion() call as extra_body,
# for whatever your backend always needs. Left blank (the default), a
# reasoning-capable backend (Qwen3-family served locally, for instance) keeps
# "thinking" ON — deliberate: reasoning can genuinely help ingest/llm_client.py's
# close-reading/alignment judgment calls, so it isn't switched off just to be safe.
LITELLM_EXTRA_BODY=

# Optional: raw JSON used only as a ONE-SHOT RETRY when a call's content comes
# back empty — the signature of a reasoning trace that filled the whole context
# window before producing an answer. This does not disable thinking generally:
# it rescues that one call, then LITELLM_EXTRA_BODY's normal behavior (thinking
# on) applies again for the next call. Left blank, a call that comes back empty
# raises instead of being retried. Provider-specific — for a locally-served
# Qwen3(.5) model (see README's "Local LLM (llama.cpp)" section):
# LITELLM_NO_THINKING_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LITELLM_NO_THINKING_EXTRA_BODY=

# Request timeout (seconds) for every litellm.completion() call. Generous by
# design (6000s = 100 min default) rather than left to litellm's own implicit
# default, which turned out in practice to be far shorter than an uncapped
# local reasoning call can need — a real ~15-minute local call was cut off
# before this was raised. Only lower this if you specifically want fast
# failure on a hung connection instead.
LITELLM_TIMEOUT_SECONDS=6000

# Search API (spec §10) — the pipeline calls this instead of holding a
# corpus/index locally. Local dev default assumes `search_api/` running via
# `uvicorn app.main:app --port 8000` from that directory; production is the
# HF Space's URL, e.g. https://<user>-ye-olde-api.hf.space
SEARCH_API_URL=http://localhost:8000
