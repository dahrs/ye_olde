# Copy to search_api/.env for local development. In production (Cloud Run),
# HF_DATASET_REPO_ID is a GitHub Actions variable and HF_TOKEN is a GCP
# Secret Manager secret ("hf-token") — never a GitHub secret or a plain env
# var, see spec §10/§13 for why. Never commit this file; it's gitignored.

HF_DATASET_REPO_ID=dahrs/ye_olde_data-index
HF_TOKEN=                      # write-scoped token from huggingface.co/settings/tokens —
                                # needed even though the repo is public: HF rate-limits
                                # fully anonymous API reads (spec §10)

# Only needed to exercise /search locally — must match whatever EMBEDDING_MODEL
# built the shards currently in HF_DATASET_REPO_ID (default already matches).
EMBEDDING_MODEL=intfloat/multilingual-e5-large
